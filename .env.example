# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
CLIENT_ID=
CLIENT_SECRET=
# Your server's ID (right-click the server icon > Copy Server ID, with Developer Mode on)
GUILD_ID=

# Public address of the console. Must match the OAuth2 redirect: <BASE_URL>/auth/callback
BASE_URL=https://console.yourdomain.com

# The app only listens on this machine; Cloudflare Tunnel forwards to it.
HOST=127.0.0.1
PORT=3000

# Comma-separated role IDs. Admins get settings, @everyone and can edit anyone's posts.
ADMIN_ROLE_IDS=
# Staff roles used on first start. After that, admins change them in Settings.
STAFF_ROLE_IDS=

# Optional
DB_PATH=data/console.db
